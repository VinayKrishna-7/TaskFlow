NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# JWT configuration
JWT_ACCESS_SECRET=taskflow_access_super_secret_jwt_key_2026_xyz123!
JWT_REFRESH_SECRET=taskflow_refresh_super_secret_jwt_key_2026_abc987!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# SMTP / Email Notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASSWORD=mock_pass
EMAIL_FROM=TaskFlow <no-reply@taskflow.dev>

# Optional AI Assistant configuration
AI_API_KEY=
